# .gitignore - Git ignore rules for ANA-CLIP-MIL project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data & Models (keep samples only)
data/*.npy
!data/samples/*.npy
data/qdrant_storage/
qdrant_storage/

# Large files
*.pt
*.pth
!models/best_model.pt

# Logs
*.log
logs/

# Temporary
.temp/
*.tmp
temp/

# OS
.DS_Store
Thumbs.db
